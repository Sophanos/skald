# AIOStreams is a separate project. See its docs and licence:
# https://github.com/Viren070/AIOStreams
# Make a private key with: openssl rand -hex 32
SECRET_KEY=
# Your public HTTPS address. Point your HTTPS proxy at 127.0.0.1:3000.
BASE_URL=https://aio.example.org
# Stored in the named Docker volume mounted at /app/data.
DATABASE_URI=sqlite://./data/db.sqlite
# Let Jellyfin apps such as Odin connect to AIOStreams.
JELLYFIN_ENABLED=true
# Turn up to 40 catalogs into libraries (the usual default is 20).
JELLYFIN_MAX_LIBRARIES=40
