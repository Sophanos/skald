# Required: private encryption key, 64 random hex characters.
SECRET_KEY=
# Required: address Odin can reach; replace the reserved hostname or use a LAN IP.
BASE_URL=http://aio.example.org:3000
# Required: SQLite database in the persistent /app/data volume.
DATABASE_URI=sqlite://./data/db.sqlite
# Required: enable the Jellyfin endpoint for Odin and Jellyfin apps.
JELLYFIN_ENABLED=true
# Optional: allow up to 40 catalogs as libraries instead of 20.
JELLYFIN_MAX_LIBRARIES=40
# Optional: refresh Skald rows every 10 minutes instead of 6 hours.
MANIFEST_CACHE_TTL=*:21600,skald:600
